# ══════════════════════════════════════════════════════════════════════════
# Открытое API HeadHunter — справочник станций метро.
# Документация: https://api.hh.ru/openapi/redoc#tag/Obshie-spravochniki
# Авторизация не требуется; нужен любой непустой User-Agent.
# Все примеры проверены 2026-07-26 и возвращают код 200.
# ══════════════════════════════════════════════════════════════════════════

### Метро Санкт-Петербурга (основной рабочий запрос).
# Возвращает объект вида:
# { "id": "2", "name": "Санкт-Петербург",
#   "lines": [ { "id": "14", "hex_color": "D6083B", "name": "Кировско-Выборгская",
#                "stations": [ { "id": "14.190", "name": "Девяткино",
#                                "lat": 60.050182, "lng": 30.443045, "order": 0,
#                                "line": {...} }, ... ] }, ... ] }
# Поле order — порядковый номер станции на линии в путевом порядке (0 — конечная).
GET https://api.hh.ru/metro/2
User-Agent: metro-research/1.0

### Список всех городов, для которых у hh.ru есть справочник метро
# (Москва — id 1, Санкт-Петербург — id 2, далее Новосибирск, Екатеринбург и другие).
GET https://api.hh.ru/metro/
User-Agent: metro-research/1.0

### Метро Москвы — для сравнения структуры ответа
GET https://api.hh.ru/metro/1
User-Agent: metro-research/1.0
